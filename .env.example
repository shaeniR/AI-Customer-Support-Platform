# Copy to .env and fill in real values. Never commit .env.

# --- Database (MySQL) ---
MYSQL_DATABASE=lankamart_support
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/lankamart_support?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=lankamart
DB_PASSWORD=lankamart

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Security ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- AI (used from week 6) ---
